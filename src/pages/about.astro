---
import Base from '../layouts/SectionLayout.astro';
import { profile } from '../data/profile';
---
<Base title="About">
  <h1>About</h1>

  <p>{profile.summary}</p>
  <nav class="site-guide" aria-label="Portfolio and Almanac">
    <div class="site-guide-row">
      <strong class="site-guide-label"><a href={profile.links.portfolio} target="_blank" rel="noopener noreferrer">Professional Portfolio</a> ↗</strong>
      <span class="site-guide-separator" aria-hidden="true">—</span>
      <span>Current profile, selected work, experience, and credentials.</span>
    </div>
    <div class="site-guide-row">
      <strong class="site-guide-label"><a href="/">Workshop Almanac</a></strong>
      <span class="site-guide-separator" aria-hidden="true">—</span>
      <span>This website: extended technical archive, project history, hardware, and logs.</span>
    </div>
  </nav>

  <h2>Technical Background</h2>

  <h3>Areas of Focus</h3>
  <ul>
    <li>LLM reliability &amp; safety</li>
    <li>Systems security</li>
    <li>Local AI infrastructure</li>
    <li>GPU / network systems</li>
    <li>Product engineering</li>
  </ul>

  <h3>Tools & Stack</h3>
  <p class="tech-line"><em>Languages:</em> {profile.languages.join(' · ')}</p>
  <p class="tech-line"><em>AI / ML:</em> {profile.stacks.aiMl.join(' · ')}</p>
  <p class="tech-line"><em>Systems:</em> {profile.stacks.systems.join(' · ')}</p>
  <p class="tech-line"><em>Data / Tooling:</em> {profile.stacks.dataTooling.join(' · ')}</p>
  <p class="tech-line"><em>Hardware:</em> Xeon E5-v3, Tesla P40, ConnectX-3, RTL-SDR</p>
  <p class="tech-line"><em>Open Source:</em> EleutherAI / MLCommons — merged upstream contributions (<a href={profile.links.eleutherAI} target="_blank" rel="noopener noreferrer">lm-evaluation-harness PR #3693</a> · <a href={profile.links.mlCommons} target="_blank" rel="noopener noreferrer">MLCommons Inference PR #2572</a>)</p>

  <h3>Certifications</h3>
  <ul>
    <li><a href={profile.links.crto} target="_blank" rel="noopener noreferrer"><strong>CRTO — Certified Red Team Operator</strong></a>, Zero-Point Security, earned August 27, 2026 (RTO-170: 100/100)</li>
    <li>HeatWave White Hat Program, 2019–2020</li>
  </ul>

  <h2>Current Work</h2>

  <p>LLM reliability and multi-provider safety evaluation through <a href="/projects/redllm">RedLLM</a>; private local-model infrastructure through <a href="/projects/qut">Qut</a> and <a href="/projects/hephaestus">Hephaestus</a>; sole full-stack development of <a href={profile.links.fittomoAppStore} target="_blank" rel="noopener noreferrer">Fittomo</a>; and privacy / network systems work.</p>

  <h2>Professional Experience</h2>

  <div class="experience-list">
    <div class="experience-item">
      <div class="phase-header">
        <span class="phase-locations">LAIVU / Fittomo — Co-Founder · CTO</span>
        <span class="phase-date">Oct 2022–Present</span>
      </div>
      <p class="phase-role"><em>Early-stage investor-backed startup · Tokyo / Vancouver</em></p>
      <ul class="bullets-circle">
        <li>Started as a sustainability-fashion EC business before pivoting into fitness and health technology; secured $35K+ in investor funding and earned NHK broadcast coverage.</li>
        <li>Led product and engineering across 2 co-founders and 3 members at peak, including compliant cross-border B2B operations.</li>
        <li>Earlier health-tech work applied ML to injury prediction, performance analytics, and user-specific feedback with clinic-adjacent partners in Southeast Asia.</li>
        <li>Now the sole full-stack engineer rebuilding <a href={profile.links.fittomoAppStore} target="_blank" rel="noopener noreferrer">Fittomo</a> in TypeScript, Firebase, and React across frontend and backend while operating the health-focused app live on the Apple App Store.</li>
      </ul>
    </div>

    <div class="experience-item">
      <div class="phase-header">
        <span class="phase-locations">Matsumoto Yamaga FC — Analytics & Data Science</span>
        <span class="phase-date">Oct 2025–Jan 2026</span>
      </div>
      <p class="phase-role"><em>Invited Collaborator · Clubhouse × J-League · Tokyo / Remote</em></p>
      <ul class="bullets-circle">
        <li>Rebuilt fragmented semi-manual athlete data into an automated 5-source Python pipeline with unified identity, deduplication, and mixed-effects modelling — 34 Yamaga athletes in the direct workflow, 157 across the broader pipeline.</li>
        <li>First reproducible analytics system for a J-League-affiliated club; in production after handoff, powering coach-facing physical, nutrition, and attendance reporting.</li>
        <li>Administered Supabase databases, accounts, and general security across several university soccer teams and a baseball program.</li>
      </ul>
    </div>

    <div class="experience-item">
      <div class="phase-header">
        <span class="phase-locations">Mercari — Enterprise Security</span>
        <span class="phase-date">Summer 2024</span>
      </div>
      <p class="phase-role"><em>Intern · TSE: 4385 · Tokyo, JP</em></p>
      <ul class="bullets-circle">
        <li>Shipped access-control tooling in a Chrome extension — dynamic network rules, OS-aware enforcement, custom headers — removing rollout dependency on VDI/fleet middleware.</li>
        <li>Built real-time password-field detection on unmanaged SaaS with iframe hooks, whitelist/DB checks, and Slack workspace limiter; partnered with security/legal on BYOD policy.</li>
        <li>Device-migration strategy cut per-user hardware spend 67% (JPY 450K → 150K/yr) across the fleet at a publicly traded company.</li>
      </ul>
    </div>

    <div class="experience-item">
      <div class="phase-header">
        <span class="phase-locations">Mobiz — AI Research</span>
        <span class="phase-date">Jun–Sep 2023</span>
      </div>
      <p class="phase-role"><em>Research Assistant · Remote</em></p>
      <ul class="bullets-circle">
        <li>Built citation-backed PDF-QA (LangChain, vector stores, OpenAI) and OCR/detection pipelines. This early applied-LLM work became a foundation for later personal systems spanning stateful agent orchestration, queue-backed recovery, and multi-provider safety evaluation.</li>
      </ul>
    </div>

    <div class="experience-item">
      <div class="phase-header">
        <span class="phase-locations">Barsan Global Logistics — Import/Export & IT</span>
        <span class="phase-date">2020, 2023</span>
      </div>
      <p class="phase-role"><em>Import Export Manager · IT Specialist</em></p>
      <ul class="bullets-circle">
        <li>NACCS customs workflows; built internal tracking and project-management tooling for import/export activity across partner logistics firms.</li>
      </ul>
    </div>
  </div>

  <h2>Timeline</h2>

  <div class="phase-timeline">

    <div class="phase">
      <div class="phase-divider"><span>Phase 6 — Build Phase</span></div>
      <div class="phase-entries">

        <div class="phase-entry">
          <div class="flag-row"><img src="/assets/flags/ca.gif" alt="CA" class="flag" /></div>
          <div class="phase-header">
            <span class="phase-locations">Vancouver</span>
            <span class="phase-date">May 2026–Present</span>
          </div>
          <p class="phase-role"><em>Ongoing</em></p>
          <ul class="bullets-circle">
            <li><strong>Fittomo:</strong> Sole full-stack engineer for the ground-up TypeScript, Firebase, and React rebuild.</li>
            <li><strong>LLM Systems:</strong> Multi-provider safety evaluation and local-model reliability work across RedLLM, Qut, and Hephaestus.</li>
            <li><strong>Privacy / Networks:</strong> Continued browser, DNS, and network-systems work documented in the project archive.</li>
          </ul>
        </div>

        <div class="phase-entry">
          <div class="flag-row"><img src="/assets/flags/jp.gif" alt="JP" class="flag" /></div>
          <div class="phase-header">
            <span class="phase-locations">Tokyo</span>
            <span class="phase-date">Feb–May 2026</span>
          </div>
          <p class="phase-role"><em>Lab & Product Development</em></p>
          <ul class="bullets-circle">
            <li><strong>Full-Stack Dev:</strong> Continued the ground-up Fittomo rebuild across frontend and backend.</li>
            <li><strong>Lab Systems:</strong> Infrastructure, security, local AI agents, and knowledge-system tooling using the operational Hephaestus platform.</li>
            <li><strong>SDR / LEO:</strong> Continued satellite/RF station work toward a complete SDR and LEO-tracking setup.</li>
            <li><strong>Documentation:</strong> Most of this phase documented through project logs on this site.</li>
          </ul>
        </div>

      </div>
    </div>

    <div class="phase">
      <div class="phase-divider"><span>Phase 5 — Field Implementation</span></div>
      <div class="phase-entries">

        <div class="phase-entry">
          <div class="flag-row"><img src="/assets/flags/kh.gif" alt="KH" class="flag" /></div>
          <div class="phase-header">
            <span class="phase-locations">Phnom Penh</span>
            <span class="phase-date">Oct 2025–Jan 2026</span>
          </div>
          <p class="phase-role"><em>Co-Founder — LAIVU Digital Health</em></p>
          <ul class="bullets-circle">
            <li><strong>Digital Health:</strong> Applied neural-network and data-modelling techniques to injury prediction, performance analysis, and user-specific feedback with clinic-adjacent partners.</li>
            <li><strong>Adversarial Defense:</strong> Built prompt-shielding for medical data in a complex regulatory environment.</li>
            <li><strong>Infrastructure:</strong> Lower-scaffolding environment — direct users, uneven data quality, and infrastructure limits as the field test condition.</li>
          </ul>
        </div>

        <div class="phase-sub">
          <p class="sub-header"><img src="/assets/flags/th.gif" alt="TH" class="flag" /><img src="/assets/flags/sg.gif" alt="SG" class="flag" /><img src="/assets/flags/kh.gif" alt="KH" class="flag" /> Southeast Asia Circuit</p>

          <div class="phase-entry sub-entry">
            <div class="phase-header">
              <span class="phase-locations">Phnom Penh</span>
              <span class="phase-date">Jan 2026</span>
            </div>
            <p class="phase-note">Returned briefly to continue digital health work and maintain momentum before the Tokyo build phase.</p>
          </div>

          <div class="phase-entry sub-entry">
            <div class="phase-header">
              <span class="phase-locations">Singapore</span>
              <span class="phase-date">Dec 2025</span>
            </div>
            <ul class="bullets-circle">
              <li><strong>Professional Checkpoint:</strong> Met an entrepreneur, investor, and advisor connected to Singapore and Dubai-facing circles; discussed startup direction and market movement.</li>
              <li><strong>Hackerspace:</strong> Presented projects at a Hackerspace/LeetCode meetup to software engineers outside the usual security-focused circle.</li>
              <li><strong>Security Culture:</strong> Met a China-based hardware/backend engineer with strict personal opsec practices.</li>
            </ul>
          </div>

          <div class="phase-entry sub-entry">
            <div class="phase-header">
              <span class="phase-locations">Bangkok</span>
              <span class="phase-date">Dec 2025</span>
            </div>
            <p class="phase-note">Brief regional stop; comparative look at Bangkok's startup energy and visible development against the usual Southeast Asia framing.</p>
          </div>

        </div>
      </div>
    </div>

    <div class="phase">
      <div class="phase-divider"><span>Phase 4 — Hardware Lab</span></div>
      <div class="phase-entries">
        <div class="phase-entry">
          <div class="flag-row"><img src="/assets/flags/jp.gif" alt="JP" class="flag" /></div>
          <div class="phase-header">
            <span class="phase-locations">Tokyo</span>
            <span class="phase-date">Sep–Oct 2025</span>
          </div>
          <p class="phase-role"><em>Hephaestus Lab</em></p>
          <ul class="bullets-circle">
            <li><strong>BIOS Recovery:</strong> Motherboard arrived non-functional; revived via direct BIOS-chip clipping and hardware-level flash.</li>
            <li><strong>NIC Revival:</strong> Recovered soft-bricked quad-port NIC through hardware-level firmware flashing to support planned network experiments.</li>
            <li><strong>Platform:</strong> Built isolated Proxmox environments for InfiniBand, GPU-defense research, and red/blue-team workloads.</li>
            <li><strong>SDR / RF:</strong> Began satellite/RF branch — antenna testing, SDR signal capture, and early LEO satellite tracking.</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="phase">
      <div class="phase-divider"><span>Phase 3 — Post-Grad Circuit</span></div>
      <div class="phase-entries">

        <div class="phase-entry">
          <div class="flag-row"><img src="/assets/flags/de.gif" alt="DE" class="flag" /></div>
          <div class="phase-header">
            <span class="phase-locations">Berlin</span>
            <span class="phase-date">Aug–Sep 2025</span>
          </div>
          <p class="phase-role"><em>Security Research</em></p>
          <ul class="bullets-circle">
            <li><strong>Security Culture:</strong> AI meetups, startup discussions, and hacker-adjacent technical spaces — adversarial systems, evasion logic, and anti-surveillance culture.</li>
            <li><strong>Research Pivot:</strong> Project direction shifted toward generative phishing shields and evasion-aware defensive systems.</li>
            <li><strong>c-base:</strong> Collaborated with local collectives including c-base.</li>
          </ul>
        </div>

        <div class="phase-entry">
          <div class="flag-row"><img src="/assets/flags/gb.gif" alt="GB" class="flag" /></div>
          <div class="phase-header">
            <span class="phase-locations">London</span>
            <span class="phase-date">Jul–Aug 2025</span>
          </div>
          <p class="phase-role"><em>Security Research & Consulting</em></p>
          <ul class="bullets-circle">
            <li><strong>Professional Circuit:</strong> Founder pitches, fintech discussions, hiring conversations, regulation panels, and security meetups.</li>
            <li><strong>Network Expansion:</strong> Met STEM students and professionals through Imperial College London circles — first post-university technical audience outside Manchester.</li>
            <li><strong>Freelance:</strong> Paid security audit on a live client-facing system ($400/hr).</li>
          </ul>
        </div>

        <div class="phase-entry">
          <div class="flag-row"><img src="/assets/flags/gb.gif" alt="GB" class="flag" /></div>
          <div class="phase-header">
            <span class="phase-locations">Manchester</span>
            <span class="phase-date">Jul 2025</span>
          </div>
          <p class="phase-role"><em>Transition</em></p>
          <p class="phase-note">Closed the university phase — final conversations with professors and peers before the post-graduation circuit.</p>
        </div>

      </div>
    </div>

    <div class="phase">
      <div class="phase-divider"><span>Phase 2 — University</span></div>
      <div class="phase-entries">
        <div class="phase-entry">
          <div class="flag-row"><img src="/assets/flags/gb.gif" alt="GB" class="flag" /></div>
          <div class="phase-header">
            <span class="phase-locations">Manchester</span>
            <span class="phase-date">2022–2025</span>
          </div>
          <p class="phase-role"><em>University of Manchester — Computer Science</em></p>
          <ul class="bullets-circle">
            <li><strong>Final-Year Project:</strong> Independent implementation and extension of <em>CREST</em> SNN for DSEC-Detection. Initial SNN-only approach failed to converge — built custom diagnostic tools to inspect activations, then pivoted to a hybrid ANN→SNN weight transfer method to stabilise the model.</li>
            <li><strong>Himorogi OS:</strong> Minimal privacy-focused Linux environment.</li>
            <li><strong>Startup:</strong> Fitness/health-tech co-founder; collaborated with Japanese universities; NHK coverage.</li>
            <li><strong>Leadership:</strong> CS Dept Rep, PASS Leader, Engineering Ambassador, Language Society tutor, President of Manchester Japanese Society.</li>
          </ul>
        </div>

        <div class="phase-sub">
          <p class="sub-header"><img src="/assets/flags/jp.gif" alt="JP" class="flag" /> Summer Deployments — Tokyo</p>

          <div class="phase-entry sub-entry">
            <div class="phase-header">
              <span class="phase-locations">Enterprise Security — Mercari</span>
              <span class="phase-date">Summer 2024</span>
            </div>
            <ul class="bullets-circle">
              <li>Access-control Chrome extension, password-field detection on unmanaged SaaS, 67% hardware-spend reduction across the fleet at a publicly traded company.</li>
            </ul>
          </div>

          <div class="phase-entry sub-entry">
            <div class="phase-header">
              <span class="phase-locations">Research & Dev</span>
              <span class="phase-date">Summer 2023</span>
            </div>
            <ul class="bullets-circle">
              <li><strong>BCI/EEG Research:</strong> Implemented Machine Learning classifiers for brain-computer interfaces (Python, Arduino).</li>
              <li><strong>Satellite Ops:</strong> Built custom antenna array for NOAA/Meteor satellite access via RTL-SDR.</li>
              <li><strong>LLM Dev:</strong> Built "PDF-QA" analysis tool (LangChain) and Live Flower Detection WebApp (YoloV8).</li>
            </ul>
          </div>

          <div class="phase-entry sub-entry">
            <div class="phase-header">
              <span class="phase-locations">RF & Security</span>
              <span class="phase-date">Summer 2022</span>
            </div>
            <ul class="bullets-circle">
              <li><strong>RF Signal Research:</strong> IT-funded key-signal recognition and replay attacks.</li>
              <li><strong>Pentesting:</strong> VEX-controller protocol vulnerability assessment.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div class="phase">
      <div class="phase-divider"><span>Phase 1 — Pre-University</span></div>
      <div class="phase-entries">
        <div class="phase-entry">
          <div class="flag-row"><img src="/assets/flags/jp.gif" alt="JP" class="flag" /></div>
          <div class="phase-header">
            <span class="phase-locations">Tokyo</span>
            <span class="phase-date">2017–2022</span>
          </div>
          <p class="phase-role"><em>Independent Research</em></p>
          <ul class="bullets-circle">
            <li><strong>White-Hat Security:</strong> Completed penetration-testing and CTF course covering offensive-security tools and workflows.</li>
            <li><strong>VEX Robotics:</strong> Team Captain — C++ control systems, Fusion360 3D modelling, and mechanical design.</li>
            <li><strong>Institutional Grant:</strong> Only student-led personal technical project in the school to receive IT department funding for independent RF research.</li>
            <li><strong>SDR / ADS-B:</strong> RTL-SDR 1090 MHz demodulation for real-time airspace visualization via SDRAngel.</li>
            <li><strong>RF Research:</strong> Key-signal recognition and replay attacks; VEX-controller protocol vulnerability assessment.</li>
            <li><strong>Freelance:</strong> Illustrator, designer, and developer (2020–2022); Google Maps interface work at Google HQ Tokyo.</li>
          </ul>
        </div>
      </div>
    </div>

  </div>

  <h2>Contact & Links</h2>

  <p><strong>Professional Portfolio:</strong> <a href={profile.links.portfolio} target="_blank" rel="noopener noreferrer">kayra-bios-portfolio.vercel.app</a></p>
  <p><strong>Resume:</strong> <a href={profile.links.resume}>[Current PDF]</a></p>
  <p><strong>Email:</strong> <a href={`mailto:${profile.email}`}>{profile.email}</a></p>
  <p><strong>LinkedIn:</strong> <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">linkedin.com/in/kayra-arai-ozturk</a></p>
  <p><strong>GitHub:</strong> <a href={profile.links.github} target="_blank" rel="noopener noreferrer">github.com/kiwaku</a></p>
  <p><strong>Earlier Portfolio Archive:</strong> <a href={profile.links.earlierPortfolio} target="_blank" rel="noopener noreferrer">historical work</a> <em>(last updated 2023)</em></p>

  <h2>Site Philosophy</h2>

  <p>Project documentation, build logs, and technical artifacts. Everything links back to source — diagrams, measurements, and code.</p>
</Base>

<style>
  /* Section spacing */
  h2 {
    margin-top: 2.5em;
    padding-top: 1em;
    border-top: 1px solid #e0e0e0;
  }

  h2:first-of-type {
    margin-top: 1.5em;
    border-top: none;
  }

  h3 {
    font-size: 16px;
    font-weight: bold;
    font-style: normal;
    margin-top: 1.2em;
    margin-bottom: 0.6em;
    color: #444;
  }

  .site-guide {
    display: grid;
    gap: 0.5em;
    margin: 1em 0 1.25em;
    padding: 0.7em 0.8em;
    border-left: 3px solid #222;
    background: #f8f8f8;
  }

  .site-guide-row {
    display: grid;
    grid-template-columns: 172px 1em minmax(0, 1fr);
    column-gap: 0.45em;
    align-items: baseline;
  }

  .site-guide-label,
  .site-guide-separator {
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .site-guide-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.1em;
    }

    .site-guide-separator {
      display: none;
    }
  }

  .tech-line {
    margin: 0.25em 0;
    line-height: 1.5;
  }

  .tech-line em {
    font-style: italic;
    color: #666;
    min-width: 90px;
    display: inline-block;
  }

  /* Phase timeline */
  .phase-timeline {
    margin: 1.5em 0;
  }

  .experience-list {
    margin: 1.5em 0 2em 0;
  }

  .experience-item {
    margin-bottom: 1.4em;
    padding-left: 1em;
  }

  .experience-item:last-child {
    margin-bottom: 0;
  }

  .phase {
    margin-bottom: 2em;
  }

  .phase:last-child {
    margin-bottom: 0;
  }

  /* Phase divider — horizontal rule with label */
  .phase-divider {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 1.2em;
  }

  .phase-divider::before,
  .phase-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #999;
  }

  .phase-divider span {
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #666;
    white-space: nowrap;
  }

  /* Phase entries */
  .phase-entries {
    padding-left: 1em;
  }

  .phase-entry {
    margin-bottom: 1.2em;
  }

  .phase-entry:last-child {
    margin-bottom: 0;
  }

  /* Header row: location + date */
  .phase-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1em;
    margin-bottom: 0.15em;
  }

  .phase-locations {
    font-weight: bold;
    font-size: 15px;
  }

  .phase-date {
    font-size: 12px;
    color: #888;
    white-space: nowrap;
  }

  .phase-role {
    margin: 0 0 0.4em 0;
    font-size: 13px;
    color: #555;
  }

  .phase-note {
    margin: 0.1em 0 0.4em 0;
    font-size: 13px;
    color: #666;
    font-style: italic;
  }

  /* Flag row — compact cluster above city names */
  .flag-row {
    display: flex;
    gap: 4px;
    margin-bottom: 2px;
  }

  .flag-row .flag,
  .sub-header .flag {
    width: 19px;
    height: 13px;
    image-rendering: pixelated;
  }

  /* Bullet lists */
  .bullets-circle {
    padding-left: 1.2em;
    margin: 0;
  }

  .bullets-circle li {
    list-style-type: circle;
    margin-bottom: 0.2em;
  }

  /* Summer deployments sub-section */
  .phase-sub {
    margin-top: 1em;
    padding-top: 0.8em;
    padding-left: 1em;
    border-left: 1px dashed #ccc;
  }

  .sub-header {
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #888;
    margin: 0 0 0.8em 0;
  }

  .sub-entry {
    margin-bottom: 1em;
  }

  .sub-entry:last-child {
    margin-bottom: 0;
  }
</style>
